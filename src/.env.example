# Broker authentication details
FYERS_CLIENT_ID=''  # This is the app_id
FYERS_SECRET_KEY='' # This is also the secret_id
FYERS_USER_PIN=""
FYERS_REDIRECT_URI='https://trade.fyers.in/api-login/redirect-uri/index.html'

# Websocket details for fyers
WEBSOCKET_URL='wss://api.fyers.in/socket/v2/data/'
SYMBOL_TICKERS=''  # (e.g., 'NSE:SBIN-EQ,NSE:RELIANCE-EQ') Comma-separated list of symbols to subscribe to
FYERS_ACCESS_TOKEN=''
FYERS_REFRESH_TOKEN=''


# LOG LEVELS 
# ERROR - 40
# WARNING - 30
# INFO  - 20
# DEBUG - 10
# The system checks if the incoming log's integer value is greater than or equal to the configured threshold. 
# Eg: for threshold=30, logs with levels ERROR(40) and WARNING(30) will be logged, while INFO(20) and DEBUG(10) will be ignored.


# Global settings
LOG_LEVEL=DEBUG
THIRD_PARTY_LOG_LEVEL=DEBUG
KAFKA_LOG_LEVEL=DEBUG
WEBSOCKET_RETRY_INTERVAL=5  # Time in seconds to wait before retrying the websocket connection
WEBSOCKET_MAX_RETRIES=5


# Data Collection settings
FINNHUB_WEBSOCKET_URI='wss://ws.finnhub.io?token=<your_token>'
FINNHUB_API_TOKEN = ""
FINNHUB_STOCK_SYMBOLS="AAPL,AMZN,CSCO"


# Kafka settings
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
FINNHUB_KAFKA_TOPIC=market_data

KAFKA_TOPIC_NORMALIZED_TRADES=trades-normalized
DEAD_LETTER_TOPIC_NORMALIZER=normalizer-dlt

KAFKA_TOPIC_CANDLES=candles
DEAD_LETTER_TOPIC_CANDLE_BUILDER=candle-builder-dlt

KAFKA_TOPIC_INDICATOR=indicators
DEAD_LETTER_TOPIC_INDICATOR=indicator-dlt

KAFKA_TOPIC_SIGNAL=signals
DEAD_LETTER_TOPIC_SIGNAL=signal-dlt

# Signal generator thresholds (weighted score across 4 strategies, each worth 0.25)
# 0.50 = 2 strategies must agree | 0.25 = 1 strategy is enough
SIGNAL_THRESHOLD_BUY=0.50
SIGNAL_THRESHOLD_STRONG_BUY=0.75
SIGNAL_THRESHOLD_SELL=-0.50
SIGNAL_THRESHOLD_STRONG_SELL=-0.75

KAFKA_TOPIC_ORDER_EXECUTOR=order-executor
DEAD_LETTER_TOPIC_ORDER_EXECUTOR=order-executor-dlt


# Database and PGAdmin settings
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
DB_HOST=timescale
DB_PORT=5432
DB_NAME=marketdata
DB_USER=postgres
DB_PASSWORD=postgres


# Docker image and version settings
PROJECT_IMAGE='<your_dockerhub_username>/market-data-pipeline'
PROJECT_VERSION='v1.0.1'